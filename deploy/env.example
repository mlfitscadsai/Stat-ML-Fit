# Copy to /opt/stat-ml-fit/.env on the VM (never commit real secrets).
FLASK_ENV=production

# HPC / Slurm SSH — required only when using "Use HPC resources" in the UI.
# Without these, the SPA still loads; HPC job routes return HTTP 503 with a clear message.
#
# HPC_HOST=hpc.example.tu-dresden.de
# HPC_USER=your_username
# HPC_PASSWORD=your_password_or_key_passphrase
