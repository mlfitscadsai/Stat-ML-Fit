{
  "name": "mlfit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-webr-assets.mjs && node scripts/copy-danfo-bundle.mjs",
    "prebuild": "node scripts/copy-webr-assets.mjs && node scripts/copy-danfo-bundle.mjs",
    "build": "vite build && node vite/check-bundle-budget.mjs",
    "preview": "vite preview",
    "test:mode": "node --experimental-default-type=module --test tests/task_mode.test.js",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@kessler/gemma-agent": "^2.0.0",
    "@tensorflow/tfjs": "^4.12.0",
    "@tensorflow/tfjs-core": "^4.12.0",
    "@tensorflow/tfjs-tsne": "^0.2.0",
    "@tensorflow/tfjs-vis": "^1.5.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "axios": "^1.7.3",
    "buefy": "^3.0.3",
    "bulma": "^1.0.4",
    "core-js": "^3.8.3",
    "crypto-browserify": "^3.12.0",
    "d3-scale-chromatic": "^3.0.0",
    "danfojs": "1.1.2",
    "highcharts": "^12.4.0",
    "jquery": "^3.7.1",
    "jspdf": "^2.5.1",
    "jstat": "^1.9.6",
    "marked": "^18.0.2",
    "ml-hclust": "^3.1.0",
    "ml-matrix": "^6.11.1",
    "ml-random-forest": "^2.1.0",
    "pinia": "^3.0.4",
    "plotly.js": "^3.2.0",
    "scikitjs": "^1.24.0",
    "seeded-rand": "^2.0.1",
    "shepherd.js": "^13.0.3",
    "simple-statistics": "^7.8.3",
    "three": "^0.184.0",
    "umap-js": "^1.4.0",
    "vite-bundle-analyzer": "^1.2.3",
    "vue-mathjax": "^0.1.1",
    "webr": "^0.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-private-methods": "^7.24.7",
    "@pinia/testing": "^1.0.3",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "jsdom": "^29.0.0",
    "vite": "^7.2.2",
    "vitest": "^4.1.0",
    "vue": "^3.5.30"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
